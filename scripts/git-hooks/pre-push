#!/usr/bin/env bash
# pre-push hook — run language-appropriate tests before every push.
# Install via: git config core.hooksPath scripts/git-hooks
#              or: bash scripts/setup-hooks.sh
#              or from a submodule: bash scripts/script-helpers/scripts/setup-hooks.sh
#
# Skip with: git push --no-verify  (discouraged; use only for docs-only pushes)
#
# git connects to the remote before this hook runs and keeps the connection open,
# idle, until it passes. Over SSH a long test run can be cut off by the server
# (push exits 141, "Connection to <host> closed by remote host"). The hook says so
# before the checks start when no SSH keepalive is set, with the ways to set one
# (scripts/ssh_keepalive.sh).
set -euo pipefail

_push_url="${2:-}"   # git passes the remote name and URL

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# A push that only deletes refs adds no commits, so there is nothing for a test
# suite to have an opinion about. Running one is pure latency, and it is the
# kind of latency that teaches people to reach for --no-verify: pruning three
# merged branches otherwise runs the full gate three times, once per deletion.
#
# Deliberately conservative. The gate is skipped only when EVERY ref in this
# push is a deletion; one added ref alongside them and the checks run as usual.
# Zeroes are matched as a pattern rather than compared with a 40-character
# constant, because a SHA-256 repository writes 64 of them.
_push_is_deletions_only() {
  local lref lsha rref rsha saw_ref=false
  # git feeds four fields per ref. Three are unread, but all four must be
  # consumed positionally or the shas land in the wrong variables.
  # shellcheck disable=SC2034
  while read -r lref lsha rref rsha; do
    [[ -n "${lsha:-}" ]] || continue
    saw_ref=true
    [[ "$lsha" =~ ^0+$ ]] || return 1
  done
  [[ "$saw_ref" == "true" ]]
}

# git feeds the ref lines on stdin, and they can only be read once. They are
# needed twice -- for the deletions-only shortcut and to work out which commits
# are actually going out -- so they are captured first.
# In a private per-run directory (mktemp -d, mode 700); refused when it cannot
# be made, since an empty path would read no refs and skip every check.
_push_tmp="$(mktemp -d 2>/dev/null)" && [[ -n "$_push_tmp" && -d "$_push_tmp" && ! -L "$_push_tmp" ]] || {
  echo "[pre-push] could not create a private temp directory; refused." >&2
  exit 1
}
chmod 700 "$_push_tmp" 2>/dev/null || true
_push_refs="$_push_tmp/refs"
# Guarded: a subshell inherits an EXIT trap, and bash runs it there when the
# subshell is signalled -- so this could tear down the caller's stack, or
# delete a directory, while the run is still using it. ${BASHPID-$$} rather
# than $BASHPID alone: bash 3.2, which macOS ships, does not define BASHPID,
# and $$ is the top-level shell's pid in every subshell, so the comparison
# degrades to always-true there rather than to always-false.
trap 'if [[ ${BASHPID-$$} == "$$" ]]; then rm -rf "$_push_tmp"; fi' EXIT
cat > "$_push_refs" || { echo "[pre-push] could not read the ref lines; refused." >&2; exit 1; }

if _push_is_deletions_only < "$_push_refs"; then
  echo "[pre-push] deletions only — no new commits to check."
  exit 0
fi

# Security steps, before anything else and before a repository's own hook:
# private names (block) -> credentials, personal identifiers, PII (block) ->
# foxguard (warnings only). See scripts/security_hooks.sh.
_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Before the checks, while it can still help: an SSH push idle during long
# checks is cut off after they pass. Not when only the tests are skipped.
if [[ "${PRE_PUSH_SKIP_TESTS:-}" != "1" && -f "$_hook_dir/../ssh_keepalive.sh" ]]; then
  # shellcheck source=/dev/null
  source "$_hook_dir/../ssh_keepalive.sh" && ssh_keepalive_note "$_push_url" "[pre-push]"
fi
_security_lib=""
for _candidate in "$_hook_dir/../security_hooks.sh" "${SCRIPT_HELPERS_SECURITY_DIR:-/nonexistent}/security_hooks.sh"; do
  [[ -f "$_candidate" ]] && { _security_lib="$_candidate"; break; }
done
if [[ -n "$_security_lib" ]]; then
  # shellcheck source=/dev/null
  source "$_security_lib"
  if ! sec_pre_push "$_push_refs" "${1:-}" "${2:-}"; then
    exit 1
  fi
else
  # A check that cannot run is not a clean one.
  if [[ "${SECURITY_GATE_ALLOW_UNCHECKED:-${SENSITIVE_ALLOW_UNCHECKED:-}}" == 1 ]]; then
    echo "[pre-push] WARNING: security_hooks.sh not found next to this hook; SECURITY_GATE_ALLOW_UNCHECKED=1, security checks skipped." >&2
  else
    echo "[pre-push] security_hooks.sh not found next to this hook; security checks cannot run; refused." >&2
    echo "[pre-push] Reinstall the hooks, or push once with SECURITY_GATE_ALLOW_UNCHECKED=1." >&2
    exit 1
  fi
fi

# A repo-local pre-push hook replaces the rest of this one (the tests), after
# the security steps above. It gets the ref lines git gave this hook.
# -ef guard: skip when it is this very file (avoids infinite recursion).
if [[ -f .githooks/pre-push ]] && ! [[ .githooks/pre-push -ef "$0" ]]; then
  _local_rc=0
  bash .githooks/pre-push "$@" < "$_push_refs" || _local_rc=$?
  exit "$_local_rc"
fi

# The tests below are not hooks: they must not inherit the global hooks'
# script directory.
unset SCRIPT_HELPERS_SECURITY_DIR

# Resolve local_test_*.sh scripts directory; submodule path takes priority.
_scripts_dir=""
if [[ -d "$repo_root/scripts/script-helpers/scripts" ]]; then
  _scripts_dir="$repo_root/scripts/script-helpers/scripts"
elif [[ -d "$repo_root/scripts" ]]; then
  _scripts_dir="$repo_root/scripts"
fi

_ran_tests=false

# preflight.sh, when the submodule is new enough, runs every check the repo's CI
# would have run and knows about stacks this hook's own chain does not — Gradle
# and Android among them. In a repo that has deleted its build workflows this
# hook is the only remaining gate, so prefer the thorough runner and fall back
# to the per-language chain below only when it is absent.
# Returns 127 when preflight is not installed — distinct from any status
# preflight itself can return, so "not available" can never be confused with
# "checks failed". Confusing the two would let a failing push through.
run_preflight() {
  local preflight=""
  if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/preflight.sh" ]]; then
    preflight="$_scripts_dir/preflight.sh"
  else
    return 127
  fi
  echo "[pre-push] preflight --quick"
  bash "$preflight" --quick
  # 3 = no stack detected. Not a failure; let the chain below try instead.
  local rc=$?
  [[ "$rc" -eq 3 ]] && return 127
  return "$rc"
}

# Inline Go runner used when local_test_go.sh is not available.
run_go_tests_inline() {
  local gomod module_dir
  while IFS= read -r gomod; do
    module_dir="$(dirname "$gomod")"
    echo "[pre-push] go test ./... ($module_dir)"
    (cd "$module_dir" && go test ./...)
  done < <(
    find . \
      \( -name .git -o -path "*/node_modules" -o -path "*/vendor" \) -prune \
      -o -type f -name go.mod -print | sort
  )
}

# A tests-only escape. Without one, a repository whose suite needs a running
# stack -- a `make test` that talks to docker -- leaves `--no-verify` as the
# only way to push, and that skips the private-name gate too. The narrow
# escape exists so nobody reaches for the wide one.
_tests_skipped_on_purpose() {
  [[ "${PRE_PUSH_SKIP_TESTS:-}" == "1" ]] || return 1
  echo "[pre-push] PRE_PUSH_SKIP_TESTS=1 — tests skipped. Everything else still ran."
  return 0
}

run_tests() {
  _tests_skipped_on_purpose && return 0
  # PHP / Laravel — composer.json is authoritative: Laravel apps also ship a
  # package.json for Vite, so once composer.json is present we run the PHP suite
  # (or skip with a clear message) and never fall through to the Node runner.
  if [[ -f composer.json ]]; then
    if ! command -v php &>/dev/null || ! command -v composer &>/dev/null; then
      echo "[pre-push] composer.json found but php/composer are not installed — skipping PHP checks; push proceeds." >&2
      echo "[pre-push] Install PHP and Composer to run these checks before pushing." >&2
      return 0
    fi
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_php.sh" ]]; then
      echo "[pre-push] local_test_php.sh --quick"
      bash "$_scripts_dir/local_test_php.sh" --quick || return $?
      _ran_tests=true
    else
      # Track whether any PHP check actually ran so _ran_tests stays honest.
      local _php_checked=false
      if [[ -x vendor/bin/pint ]]; then
        echo "[pre-push] vendor/bin/pint --test"
        vendor/bin/pint --test
        _php_checked=true
      fi
      if [[ "${SKIP_PHP_TESTS:-}" != "1" ]]; then
        if [[ -f artisan ]]; then
          echo "[pre-push] php artisan test"
          php artisan test || return $?
          _php_checked=true
        elif [[ -x vendor/bin/phpunit ]]; then
          echo "[pre-push] vendor/bin/phpunit"
          vendor/bin/phpunit
          _php_checked=true
        fi
      fi
      if [[ "$_php_checked" == "true" ]]; then
        _ran_tests=true
      else
        echo "[pre-push] composer.json found but no PHP checks ran (no pint/artisan/phpunit, or tests skipped)." >&2
      fi
    fi
    return 0
  fi

  # Node / npm workspaces — only return when tests actually ran; otherwise fall through.
  if [[ -f package.json ]] && command -v npm &>/dev/null; then
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_node.sh" ]]; then
      echo "[pre-push] local_test_node.sh --quick"
      bash "$_scripts_dir/local_test_node.sh" --quick || return $?
      _ran_tests=true
      return 0
    elif command -v node &>/dev/null; then
      local test_script
      test_script="$(
        node -pe '
          var pkg = require("./package.json");
          var test = (pkg.scripts && pkg.scripts.test) || "";
          test === "echo \"Error: no test specified\" && exit 1" ? "" : test;
        ' 2>/dev/null || echo ""
      )"
      if [[ -n "$test_script" ]]; then
        echo "[pre-push] npm test"
        npm test || return $?
        _ran_tests=true
        return 0
      fi
    fi
    # package.json present but no runnable test command — fall through to other runners.
  fi

  # Python — only return when tests actually ran; otherwise fall through.
  if [[ -f pyproject.toml ]] || [[ -f setup.py ]] || [[ -f requirements.txt ]]; then
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_python.sh" ]]; then
      echo "[pre-push] local_test_python.sh --quick"
      bash "$_scripts_dir/local_test_python.sh" --quick || return $?
      _ran_tests=true
      return 0
    else
      local python_bin=""
      if [[ -x venv/bin/python ]]; then python_bin="venv/bin/python"
      elif [[ -x .venv/bin/python ]]; then python_bin=".venv/bin/python"
      elif command -v python3 &>/dev/null; then python_bin="python3"
      elif command -v python &>/dev/null; then python_bin="python"; fi

      if [[ -n "$python_bin" ]] && "$python_bin" -m pytest --version &>/dev/null; then
        echo "[pre-push] $python_bin -m pytest"
        "$python_bin" -m pytest --tb=short -q
        _ran_tests=true
        return 0
      fi
    fi
    # Python files present but pytest not available — fall through to other runners.
  fi

  # Go — detect go.mod first so non-Go repos fall through to Rust/Flutter.
  if command -v go &>/dev/null; then
    local first_gomod
    first_gomod="$(find . \( -name .git -o -path "*/node_modules" -o -path "*/vendor" \) -prune \
      -o -type f -name go.mod -print -quit)"
    if [[ -n "$first_gomod" ]]; then
      if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_go.sh" ]]; then
        echo "[pre-push] local_test_go.sh --quick"
        bash "$_scripts_dir/local_test_go.sh" --quick || return $?
      else
        run_go_tests_inline
      fi
      _ran_tests=true
      return 0
    fi
  fi

  # Gradle / Android — checked before Flutter, because a Flutter repo's android/
  # subdirectory is built by `flutter build` and must not match here, while a
  # native Android or plain JVM repo has no pubspec.yaml to fall through to.
  if [[ ! -f pubspec.yaml ]] && { [[ -x ./gradlew ]] || [[ -f settings.gradle ]] || [[ -f settings.gradle.kts ]]; }; then
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_gradle.sh" ]]; then
      echo "[pre-push] local_test_gradle.sh --quick"
      bash "$_scripts_dir/local_test_gradle.sh" --quick || return $?
      _ran_tests=true
      return 0
    elif [[ -x ./gradlew ]]; then
      echo "[pre-push] ./gradlew test"
      ./gradlew --no-daemon test || return $?
      _ran_tests=true
      return 0
    fi
    # settings.gradle but no wrapper — fall through rather than invoking a
    # system gradle at a version the project did not pin.
  fi

  # Rust
  if [[ -f Cargo.toml ]] && command -v cargo &>/dev/null; then
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_rust.sh" ]]; then
      echo "[pre-push] local_test_rust.sh --quick"
      bash "$_scripts_dir/local_test_rust.sh" --quick || return $?
    else
      echo "[pre-push] cargo test"
      cargo test || return $?
    fi
    _ran_tests=true
    return 0
  fi

  # Flutter / Dart
  if [[ -f pubspec.yaml ]] && command -v flutter &>/dev/null; then
    if [[ -n "$_scripts_dir" ]] && [[ -f "$_scripts_dir/local_test_flutter.sh" ]]; then
      echo "[pre-push] local_test_flutter.sh --quick"
      bash "$_scripts_dir/local_test_flutter.sh" --quick || return $?
    else
      echo "[pre-push] flutter test"
      flutter test || return $?
    fi
    _ran_tests=true
    return 0
  fi

  # Shell repositories. Nothing above matches a repo with no manifest file, so
  # this hook used to print "No test runner detected" and exit 0 for them -- and
  # both shared libraries here are shell repos. A broken push reported success.
  local candidate mk=""
  for candidate in Makefile makefile GNUmakefile; do
    [[ -f "$candidate" ]] && { mk="$candidate"; break; }
  done
  if [[ -n "$mk" ]] && grep -qE '^test[[:space:]]*:' "$mk"; then
    echo "[pre-push] make test"
    make test || return $?
    _ran_tests=true
    return 0
  fi

  local bats_files=()
  while IFS= read -r candidate; do bats_files+=("$candidate"); done \
    < <(find tests -maxdepth 1 -name '*.bats' 2>/dev/null | sort)
  if [[ ${#bats_files[@]} -gt 0 ]] && command -v bats >/dev/null 2>&1; then
    echo "[pre-push] bats tests"
    bats tests || return $?
    _ran_tests=true
    return 0
  fi

  # tests/*_test.sh, the convention this library uses for itself.
  local sh_tests=()
  while IFS= read -r candidate; do sh_tests+=("$candidate"); done \
    < <(find tests -maxdepth 1 -name '*_test.sh' 2>/dev/null | sort)
  if [[ ${#sh_tests[@]} -gt 0 ]]; then
    echo "[pre-push] ${#sh_tests[@]} shell test file(s) under tests/"
    for candidate in "${sh_tests[@]}"; do
      echo "[pre-push]   $candidate"
      bash "$candidate" || return $?
    done
    _ran_tests=true
    return 0
  fi

  if [[ ${#bats_files[@]} -gt 0 ]]; then
    echo "[pre-push] tests/*.bats present but bats is not installed — nothing ran." >&2
    return 1
  fi

  echo "[pre-push] No test runner detected — skipping. Run tests manually before pushing."
}

# Unset git's hook variables before running the repository's tests.
#
# Why: git sets GIT_DIR (and similar variables) for a hook, pointing at the
# repository being pushed. The checks above need them. Tests must not see
# them: GIT_DIR beats the current directory, so a test that makes its own
# temporary repository would use the pushed one instead. In a linked worktree
# GIT_DIR is an absolute path, and there such tests failed only inside the
# hook, and the push was refused.
#
# Exception: the variables are kept if git, without them, would find no
# repository here, a different repository, or a different work tree. That is
# `git --git-dir=... --work-tree=... push`, where the variables are the only
# way to find the right place.
#
# What is unset: the names `git rev-parse --local-env-vars` prints, plus the
# six a hook always gets, written out in case that command is missing.
_drop_git_hook_env() {
  local names with without
  names="$(git rev-parse --local-env-vars 2>/dev/null || true) GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY"
  # Where git looks now, and where it would look without the variables.
  with="$(git rev-parse --absolute-git-dir --show-toplevel 2>/dev/null)" || return 0
  # shellcheck disable=SC2086  # $names is a list: one variable name per word
  without="$(unset $names; git rev-parse --absolute-git-dir --show-toplevel 2>/dev/null)" || return 0
  [[ -n "$with" && "$with" == "$without" ]] || return 0
  # shellcheck disable=SC2086
  unset $names
}
_drop_git_hook_env

_preflight_rc=0
run_preflight || _preflight_rc=$?
if [[ "$_preflight_rc" -eq 0 ]]; then
  echo "[pre-push] All checks passed."
  exit 0
elif [[ "$_preflight_rc" -ne 127 ]]; then
  echo "[pre-push] preflight failed — push refused." >&2
  echo "[pre-push] Fix the failures above, or use 'git push --no-verify' if you know why." >&2
  exit "$_preflight_rc"
fi

# Captured, not left to `set -e`. Calling run_tests in a `||` context disables
# -e INSIDE it, so every runner needs its own `|| return $?` -- without them a
# failing `make test` or `npm test` fell through to `return 0` and the push was
# allowed. Checked by driving a repo whose tests exit 1.
_tests_rc=0
run_tests || _tests_rc=$?
if [[ "$_tests_rc" -ne 0 ]]; then
  echo "[pre-push] tests failed — push refused." >&2
  echo "[pre-push] Fix them, or, if this suite needs services this machine has not got:" >&2
  echo "[pre-push]   PRE_PUSH_SKIP_TESTS=1 git push    tests only; every other check still runs" >&2
  echo "[pre-push]   git push --no-verify              skips everything, including the" >&2
  echo "[pre-push]                                     private-name check. Prefer the first." >&2
  exit "$_tests_rc"
fi
if [[ "$_ran_tests" == "true" ]]; then
  echo "[pre-push] All checks passed."
fi
